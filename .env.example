# Copy to .env. docker-compose reads these; src/index.js reads them via dotenv.

# --- Postgres (used by the db container and the api) ---
POSTGRES_USER=vciso
POSTGRES_PASSWORD=vciso_dev_password
POSTGRES_DB=vciso
POSTGRES_PORT=5432

# --- API ---
API_PORT=4000

# Running the api outside Docker? Point it at the db exposed on localhost.
# Either DATABASE_URL or the PG* variables work; DATABASE_URL wins if both are set.
# DATABASE_URL=postgresql://vciso:vciso_dev_password@localhost:5432/vciso
PGHOST=localhost
PGPORT=5432
PGUSER=vciso
PGPASSWORD=vciso_dev_password
PGDATABASE=vciso
# Set to true for managed Postgres that requires TLS (Supabase, RDS, ...)
PGSSL=false

# --- Client instance (see README: "Run a client instance") ---
# Folder holding the client's instance.json (written by the bundle builder); `npm run link` writes
# link.json there. The API serves nothing but /api/health and /api/instance until both match the database.
# CTW_INSTANCE_DIR=dist_client/Cust_00101
# Where uploaded evidence files go (default: <CTW_INSTANCE_DIR>/evidence).
# CTW_EVIDENCE_DIR=
# Development only: hand the MFA code back to the login page (there is no mail delivery yet).
# CTW_DEV_MFA=true
