# One-time passwords written by db/generate_client_schema.py
dist_client/*/initial_credentials.txt

# Documents
docs/
# Instance link (holds the session secret) written by `npm run link`
dist_client/*/link.json
# Evidence files stored next to a dev instance (CTW_EVIDENCE_DIR default)
dist_client/*/evidence/

# CTW admin: generated bundles and client image files (passwords never land here, but SQL and images do)
ctw-admin/builds/
