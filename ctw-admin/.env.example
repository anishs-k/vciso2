# Copy to ctw-admin/.env. docker-compose.yml and scripts/*.js read it.

# --- CTW central database ---
CTW_DB_USER=ctw_admin
CTW_DB_PASSWORD=change_me_ctw_dev
CTW_DB_NAME=ctw
CTW_DB_PORT=5440
CTW_DATABASE_URL=postgres://ctw_admin:change_me_ctw_dev@localhost:5440/ctw

# --- Seed (npm run seed) ---
# First CTW admin, created only while ctw_admin_user is empty; its password is printed once.
CTW_ADMIN_LOGIN=ctw.admin
CTW_ADMIN_NAME=CTW Administrator
CTW_ADMIN_EMAIL=admin@cybertrustworks.example

# Python with openpyxl (the project's .venv). Default: ../.venv/Scripts/python.exe on Windows,
# ../.venv/bin/python elsewhere.
# CTW_PYTHON=

# --- Admin API (npm run dev) ---
CTW_ADMIN_PORT=4500
# Signs admin sessions: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CTW_SESSION_SECRET=
# CTW_SESSION_TTL_SECONDS=28800

# --- Licence sealing (bundle builder) ---
# Signs every client licence: 32+ random characters, kept secret, never changed once clients are live.
CTW_LICENSE_SECRET=

# --- Builds ("Generate Docker Image") ---
# Where bundles and image files are kept (default ctw-admin/builds). Needs Docker on this machine.
# CTW_BUILDS_DIR=
# CTW_IMAGE_REPO=cybertrustworks/vciso-platform

# --- Security ---
# Encrypts admins' MFA secrets (32+ random characters). Losing or changing it means every admin sets up MFA again.
CTW_DATA_KEY=
# Every admin must use an authenticator app (TOTP). Only set false for local development.
CTW_REQUIRE_MFA=true
# Interface to listen on: keep 127.0.0.1 and put a TLS proxy / the VPN in front.
CTW_ADMIN_HOST=127.0.0.1
